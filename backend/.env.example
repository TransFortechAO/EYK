# Copie para .env na pasta backend. Nunca publique o ficheiro .env real.

# Django: DJANGO_SECRET_KEY é preferido; SECRET_KEY é aceite por compatibilidade.
DJANGO_SECRET_KEY=
# SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de dados: em produção pode usar DATABASE_URL (recomendado)
# DATABASE_URL=postgresql://utilizador:senha@localhost:5432/eyk_db
# Alternativa compatível com a configuração antiga:
DB_NAME=eyk_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# URLs do frontend. Inclua o esquema e a porta, sem barra final.
NEXT_PUBLIC_URL=http://localhost:3000
CORS_EXTRA=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS_EXTRA=

# Rede local no ambiente de desenvolvimento: IP do computador servidor Django.
LAN_IP=192.168.1.122

# Cache partilhada (Redis) — necessária em produção para os limites de
# frequência (ex: recuperação de palavra-passe) funcionarem entre workers.
CACHE_URL=redis://localhost:6379/2
# True se o Django estiver atrás de um proxy (nginx) que envia o IP real em X-Forwarded-For.
CONFIAR_X_FORWARDED_FOR=False

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
