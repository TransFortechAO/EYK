# Copie para .env na pasta backend. Nunca publique o ficheiro .env real.

# Django: DJANGO_SECRET_KEY é preferido; SECRET_KEY é aceite por compatibilidade.
DJANGO_SECRET_KEY=
# SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de dados: em produção pode usar DATABASE_URL (recomendado)
# DATABASE_URL=postgresql://utilizador:senha@localhost:5432/eyk_db
# Alternativa compatível com a configuração antiga:
DB_NAME=eyk_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# URLs do frontend. Inclua o esquema e a porta, sem barra final.
NEXT_PUBLIC_URL=http://localhost:3000
CORS_EXTRA=
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS_EXTRA=

# Rede local no ambiente de desenvolvimento: IP do computador servidor Django.
LAN_IP=192.168.1.122

# Cache partilhada (Redis) — necessária em produção para os limites de
# frequência (ex: recuperação de palavra-passe) funcionarem entre workers.
CACHE_URL=redis://localhost:6379/2
# True se o Django estiver atrás de um proxy (nginx) que envia o IP real em X-Forwarded-For.
CONFIAR_X_FORWARDED_FOR=False

# Celery (anúncios em segundo plano, lembrete de ofensiva e anúncios agendados).
# Sem CELERY_BROKER_URL as tarefas correm logo no próprio pedido e não há
# agendador — chega para desenvolvimento. Para testar o agendador localmente:
#   celery -A config worker -B -l info
# CELERY_BROKER_URL=redis://localhost:6379/0

# Produção (DJANGO_ENV=prod) — ver docs/DEPLOY_RENDER.md
# DJANGO_ENV=prod
# MEDIA_ROOT=/var/data/media
# Media num bucket S3-compatível (Cloudflare R2, AWS S3), em vez do disco:
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<conta>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=media.exemplo.ao
# SENTRY_DSN=

# Email (opcional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
