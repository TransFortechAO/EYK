# Copia este ficheiro para ".env" (na mesma pasta, ao lado do manage.py) e preenche os valores reais.
# NUNCA commites o ficheiro ".env" — só este exemplo vai para o git.

# Django
SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — vazio em dev usa SQLite local automaticamente.
# Em produção: DATABASE_URL=postgres://user:password@host:5432/eyk_db
DATABASE_URL=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Email — usa uma App Password do Google (https://myaccount.google.com/apppasswords),
# nunca a password normal da conta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google (sincronização de professores via Google Sheets) — opcional,
# por default usa BASE_DIR/credentials.json
# GOOGLE_CREDENTIALS_FILE=
