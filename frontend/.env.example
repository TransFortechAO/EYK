# Configurações do Next.js
NODE_ENV=development

# URL do backend Django (API), sem sufixo /api. Opcional em desenvolvimento —
# sem esta variável, a app deriva o endereço automaticamente a partir do host
# usado para a aceder (funciona também pela rede local). Define isto em
# produção, apontando para o domínio real do backend.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000