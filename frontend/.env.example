# URL da API Django. Em desenvolvimento, deixa por definir para o Next
# encaminhar os pedidos ao Django em 127.0.0.1:8000.
# Também podes usar "/" para forçar pedidos pelo mesmo domínio.
# NEXT_PUBLIC_API_URL=/

# Produção: o Next.js reencaminha /api, /accounts, /media… para o Django
# (mesmo domínio → cookies de sessão próprios). Ambos lidos no build.
# API_INTERNO=http://eyk-api:10000
# NEXT_PUBLIC_API_URL=/

# URL base do frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hostnames/IPs adicionais a partir dos quais os browsers acedem ao Next.js
# em desenvolvimento. Separar por vírgulas e sem http:// ou porta.
# NEXT_ALLOWED_DEV_ORIGINS_EXTRA=192.168.1.50,192.168.1.60

# Área "Instituição" (parcerias), ainda com dados de demonstração — ver
# docs/INSTITUICOES_FRONTEND.md. Visível em desenvolvimento; noutros
# ambientes só com 1. Com 0, fica desligada também em desenvolvimento.
# NEXT_PUBLIC_INSTITUICOES=1
